<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Echchara" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0B1B36</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <!-- Payment pause screen: drawn over the app underneath -->
    <style name="Theme.Echchara.Pause" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="bg">#F5F7FA</color>
    <color name="brand">#1554D1</color>
</resources>
